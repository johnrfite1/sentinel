# Sentinel — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit `.env`.
#
# House rule 6: testnet keys only, and only lab-generated ones. Never a personal key.

# --- Untrusted agent under test (A-003, qualified by D-007) ---
# Used only by the agent-under-test and the mandate-drafting step. The agent is
# untrusted by design, so this key's blast radius is billing, not funds.
ANTHROPIC_API_KEY=

# Recorded into every injection fixture per D-007. Change these and the pinned
# transcripts no longer describe the run that produced them.
SENTINEL_AGENT_MODEL=claude-opus-5
SENTINEL_AGENT_TEMPERATURE=1.0

# --- Local chain ---
# Anvil's default dev mnemonic is publicly known and safe for local work.
# It is NOT a secret and is deliberately checked in as a default.
ANVIL_RPC_URL=http://127.0.0.1:8545

# --- Base Sepolia (A-002 — deferred until the local Anvil suite is green) ---
# Lab-generated key only. Leave blank until that deployment is actually authorized.
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_DEPLOYER_KEY=
